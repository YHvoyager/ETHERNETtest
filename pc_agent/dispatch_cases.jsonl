# dispatcher 的离线自测集。
#
# 一行一条：{"raw": 你平时会怎么说, "action": 期望的 action, "arg": 期望的参数}
#
# 规则：
#   * 这个文件是**验收标准** —— `python dispatcher.py --test` 跑它，
#     规则层必须 100% 通过（规则层是确定性的，过不了就是规则写错了）。
#   * 只写 `action` 不写 `arg` 表示 "只要 action 对，参数不管"。
#   * `action: null` 表示期望被**拒绝**（说法太模糊，不该瞎猜）。
#   * 以 # 开头的是注释，空行忽略。
#
# 想加新的说法：直接加一行，然后 --test。规则接不住再交给 LLM 那层。

# ---- 开关屏 ----
{"raw": "清屏", "action": "cmd", "arg": "OLED CLR"}
{"raw": "把屏幕清干净", "action": "cmd", "arg": "OLED CLR"}
{"raw": "黑屏", "action": "cmd", "arg": "OLED CLR"}
{"raw": "关屏", "action": "cmd", "arg": "OLED OFF"}
{"raw": "把屏幕关了", "action": "cmd", "arg": "OLED OFF"}
{"raw": "开屏", "action": "cmd", "arg": "OLED ON"}
{"raw": "把屏幕打开", "action": "cmd", "arg": "OLED ON"}
{"raw": "屏幕全亮", "action": "cmd", "arg": "OLED FILL"}
{"raw": "唤醒屏幕", "action": "cmd", "arg": "OLED ON"}
{"raw": "亮一下屏幕", "action": "cmd", "arg": "OLED ON"}
{"raw": "让屏幕熄灭", "action": "cmd", "arg": "OLED OFF"}
{"raw": "重新初始化屏幕", "action": "cmd", "arg": "OLED INIT"}

# ---- 带参数的说法：参数不能被规则层丢掉 ----
{"raw": "播眼睛 5 秒", "action": "anim", "arg": "eyes"}
{"raw": "播汽车 2 倍速", "action": "anim", "arg": "car"}

# ---- LED ----
{"raw": "把灯打开", "action": "cmd", "arg": "LED 0 1"}
