# ---- 内置动画 ----
{"raw": "播汽车", "action": "anim", "arg": "car"}
{"raw": "放个烟花", "action": "anim", "arg": "fireworks"}
{"raw": "来点雨", "action": "anim", "arg": "rain"}
{"raw": "下雨", "action": null}
